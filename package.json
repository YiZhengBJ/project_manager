{
  "name": "project-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Tauri desktop project manager with a dependency-free frontend",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build --bundles app && python3 scripts/package_macos.py",
    "build:frontend": "python3 scripts/frontend.py build",
    "preview": "python3 scripts/frontend.py dev",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "build:app": "tauri build --bundles app"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1"
  }
}
